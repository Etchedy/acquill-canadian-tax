# Fly.io image: same service as Dockerfile, but Fly mounts the index volume owned by root, so the container
# starts as root only to hand /app/data to the service user, then drops privileges for the server itself.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOST=0.0.0.0 PORT=8000 TAX_DB=/app/data/cra.sqlite3
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . && useradd --uid 10001 --create-home acquill && mkdir -p /app/data
EXPOSE 8000
CMD ["sh","-c","chown -R acquill:acquill /app/data && exec setpriv --reuid=acquill --regid=acquill --init-groups canadian-tax-mcp"]
